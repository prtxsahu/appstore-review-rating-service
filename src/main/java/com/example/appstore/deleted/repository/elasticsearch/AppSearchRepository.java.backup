package com.example.appstore.repository.elasticsearch;

import com.example.appstore.domain.App;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import co.elastic.clients.elasticsearch.ElasticsearchClient;
import co.elastic.clients.elasticsearch._types.query_dsl.Query;
import co.elastic.clients.elasticsearch.core.SearchRequest;
import co.elastic.clients.elasticsearch.core.SearchResponse;
import co.elastic.clients.elasticsearch.core.IndexRequest;
import co.elastic.clients.elasticsearch.core.IndexResponse;
import co.elastic.clients.elasticsearch.core.UpdateRequest;
import co.elastic.clients.elasticsearch.core.UpdateResponse;
import co.elastic.clients.elasticsearch.core.search.Hit;
import co.elastic.clients.elasticsearch.indices.CreateIndexRequest;
import co.elastic.clients.elasticsearch.indices.ExistsRequest;
import org.springframework.stereotype.Repository;

import java.io.IOException;
import java.time.Instant;
import java.util.ArrayList;
import java.util.List;

/**
 * Repository for App search operations using OpenSearch/Elasticsearch.
 * Handles indexing and searching of apps for keyword-based search.
 */
@Slf4j
@Repository
@RequiredArgsConstructor
public class AppSearchRepository {

    private final ElasticsearchClient elasticsearchClient;
    private static final String INDEX_NAME = "apps_index";

    /**
     * Create the apps index if it doesn't exist.
     */
    public void createIndexIfNotExists() {
        try {
            ExistsRequest existsRequest = ExistsRequest.of(e -> e.index(INDEX_NAME));
            boolean exists = elasticsearchClient.indices().exists(existsRequest).value();
            
            if (!exists) {
                log.info("Creating apps index: {}", INDEX_NAME);
                CreateIndexRequest createRequest = CreateIndexRequest.of(c -> c
                        .index(INDEX_NAME)
                        .mappings(m -> m
                                .properties("appId", p -> p.keyword(k -> k))
                                .properties("name", p -> p.text(t -> t.analyzer("standard")))
                                .properties("description", p -> p.text(t -> t.analyzer("standard")))
                                .properties("avgRating", p -> p.double_(d -> d))
                                .properties("updatedAt", p -> p.date(d -> d))
                        )
                );
                elasticsearchClient.indices().create(createRequest);
                log.info("Successfully created apps index: {}", INDEX_NAME);
            } else {
                log.debug("Apps index already exists: {}", INDEX_NAME);
            }
        } catch (IOException e) {
            log.error("Error creating apps index: {}", INDEX_NAME, e);
            throw new RuntimeException("Failed to create apps index", e);
        }
    }

    /**
     * Index an app document for search.
     */
    public void indexApp(App app) {
        try {
            log.debug("Indexing app: {}", app.getAppId());
            
            // Create a map for the document to avoid serialization issues
            java.util.Map<String, Object> docMap = new java.util.HashMap<>();
            docMap.put("appId", app.getAppId());
            docMap.put("name", app.getName());
            docMap.put("description", app.getDescription());
            docMap.put("avgRating", app.getAvgRating() != null ? app.getAvgRating().doubleValue() : 0.0);
            docMap.put("updatedAt", app.getUpdatedAt() != null ? app.getUpdatedAt().toString() : null);
            
            IndexRequest<java.util.Map<String, Object>> indexRequest = IndexRequest.of(i -> i
                    .index(INDEX_NAME)
                    .id(app.getAppId())
                    .document(docMap)
            );
            
            IndexResponse response = elasticsearchClient.index(indexRequest);
            log.info("Successfully indexed app: {} with version: {}", app.getAppId(), response.version());
        } catch (IOException e) {
            log.error("Error indexing app: {}", app.getAppId(), e);
            throw new RuntimeException("Failed to index app", e);
        }
    }

    /**
     * Search apps by keyword with pagination.
     */
    public List<App> searchApps(String keyword, int page, int size) {
        try {
            log.debug("Searching apps with keyword: {}, page: {}, size: {}", keyword, page, size);
            
            Query query = Query.of(q -> q
                    .multiMatch(m -> m
                            .query(keyword)
                            .fields("name^2", "description") // Boost name field
                            .type(co.elastic.clients.elasticsearch._types.query_dsl.TextQueryType.BestFields)
                            .fuzziness("AUTO")
                    )
            );
            
            SearchRequest searchRequest = SearchRequest.of(s -> s
                    .index(INDEX_NAME)
                    .query(query)
                    .from(page * size)
                    .size(size)
                    .sort(sort -> sort
                            .score(sc -> sc.order(co.elastic.clients.elasticsearch._types.SortOrder.Desc))
                    )
            );
            
            SearchResponse<java.util.Map> searchResponse = elasticsearchClient.search(searchRequest, java.util.Map.class);
            
            // Convert Map results to App objects
            List<App> apps = new ArrayList<>();
            if (searchResponse.hits() != null && searchResponse.hits().hits() != null) {
                for (Hit<java.util.Map> hit : searchResponse.hits().hits()) {
                    java.util.Map<String, Object> source = (java.util.Map<String, Object>) hit.source();
                    if (source != null) {
                        App app = App.builder()
                                .appId((String) source.get("appId"))
                                .name((String) source.get("name"))
                                .description((String) source.get("description"))
                                .avgRating(source.get("avgRating") != null ? 
                                    java.math.BigDecimal.valueOf(((Number) source.get("avgRating")).doubleValue()) : java.math.BigDecimal.ZERO)
                                .updatedAt(source.get("updatedAt") != null ? 
                                    java.time.Instant.parse((String) source.get("updatedAt")) : null)
                                .build();
                        apps.add(app);
                    }
                }
            }
            
            log.info("Found {} apps for keyword: {}", apps.size(), keyword);
            return apps;
        } catch (IOException e) {
            log.error("Error searching apps with keyword: {}", keyword, e);
            throw new RuntimeException("Failed to search apps", e);
        }
    }

    /**
     * Delete an app from the search index.
     */
    public void deleteApp(String appId) {
        try {
            log.debug("Deleting app from search index: {}", appId);
            elasticsearchClient.delete(d -> d
                    .index(INDEX_NAME)
                    .id(appId)
            );
            log.info("Successfully deleted app from search index: {}", appId);
        } catch (IOException e) {
            log.error("Error deleting app from search index: {}", appId, e);
            throw new RuntimeException("Failed to delete app from search index", e);
        }
    }

    /**
     * Update an app in the search index.
     */
    public void updateApp(App app) {
        // For OpenSearch, update is the same as index (upsert behavior)
        indexApp(app);
    }
    
    /**
     * Update only the avgRating field of an app in Elasticsearch.
     * Uses partial update to avoid overwriting other fields.
     * 
     * @param appId The application ID
     * @param avgRating The new average rating
     */
    public void updateAppRating(String appId, double avgRating) {
        try {
            log.debug("Updating app rating in Elasticsearch - appId: {}, avgRating: {}", appId, avgRating);
            
            // Create partial update document
            java.util.Map<String, Object> updateDoc = new java.util.HashMap<>();
            updateDoc.put("avgRating", avgRating);
            updateDoc.put("updatedAt", Instant.now().toString());
            
            UpdateRequest<java.util.Map<String, Object>, java.util.Map<String, Object>> updateRequest = 
                UpdateRequest.of(u -> u
                    .index(INDEX_NAME)
                    .id(appId)
                    .doc(updateDoc)
                );
            
            UpdateResponse<java.util.Map<String, Object>> response = elasticsearchClient.update(updateRequest, java.util.Map.class);
            
            log.info("Successfully updated app rating in Elasticsearch - appId: {}, avgRating: {}, version: {}", 
                    appId, avgRating, response.version());
        } catch (IOException e) {
            log.error("Error updating app rating in Elasticsearch - appId: {}, avgRating: {}", appId, avgRating, e);
            throw new RuntimeException("Failed to update app rating in Elasticsearch", e);
        }
    }
}
